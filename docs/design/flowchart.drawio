<mxCell id="band_0" value="SETUP" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#BFBFBF;verticalAlign=top;align=right;spacingRight=10;fontStyle=1;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="24.0" y="49.2" width="1092.0" height="295.2" as="geometry"/></mxCell>
<mxCell id="band_1" value="PART A - sessions with a fixed time come first" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF9F0;strokeColor=#BFBFBF;verticalAlign=top;align=right;spacingRight=10;fontStyle=1;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="24.0" y="356.4" width="1092.0" height="379.8" as="geometry"/></mxCell>
<mxCell id="band_2" value="PART B - all other sessions" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#BFBFBF;verticalAlign=top;align=right;spacingRight=10;fontStyle=1;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="24.0" y="748.2" width="1092.0" height="1011.0" as="geometry"/></mxCell>
<mxCell id="n_start" value="START: generate the timetable" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#E7E6E6;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="192.0" y="57.6" width="336.0" height="35.4" as="geometry"/></mxCell>
<mxCell id="n_load" value="(1) Load the input data: courses, instructors, rooms and special requests (the four files in data/)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#DDEBF7;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="113.4" width="468.0" height="51.6" as="geometry"/></mxCell>
<mxCell id="n_sessions" value="Make the sessions: one theory block (-T) and one laboratory block (-L) for each course. A LAB_BEFORE_THEORY request switches SC-01 off for its course" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="185.4" width="468.0" height="69.0" as="geometry"/></mxCell>
<mxCell id="n_fixed" value="(2) Identify the fixed-time sessions (sessions with a MANDATORY FIXED_TIME request)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="274.8" width="468.0" height="51.6" as="geometry"/></mxCell>
<mxCell id="n_d_fixed" value="Is there a fixed-time session that is not processed yet?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="364.8" width="468.0" height="74.4" as="geometry"/></mxCell>
<mxCell id="n_d_ftime" value="(6) Only the fixed time is tried. Do all TIME rules pass? (HC-04, HC-08, HC-01, HC-03, HC-07, HC-10)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="459.6" width="468.0" height="91.8" as="geometry"/></mxCell>
<mxCell id="n_d_froom" value="Is there a room that passes all ROOM rules? (HC-11, HC-06, HC-05, HC-09, HC-02)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="571.8" width="468.0" height="91.8" as="geometry"/></mxCell>
<mxCell id="n_f_assign" value="(9) Assign the session to its fixed time and to the room" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="684.0" width="468.0" height="34.2" as="geometry"/></mxCell>
<mxCell id="n_d_more" value="Is there a session that is not processed yet?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="756.6" width="468.0" height="74.4" as="geometry"/></mxCell>
<mxCell id="n_select" value="(3) Select the next unscheduled session" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="851.4" width="468.0" height="34.2" as="geometry"/></mxCell>
<mxCell id="n_d_pref" value="Has it a PREFERRED time that passes all rules and has a free room?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="906.0" width="468.0" height="74.4" as="geometry"/></mxCell>
<mxCell id="n_next_time" value="(4) Take the next time: Monday to Friday, start hour 09:00, 10:00, ... (the block must end by 17:00)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="1000.8" width="468.0" height="51.6" as="geometry"/></mxCell>
<mxCell id="n_d_time" value="(6) Do all TIME rules pass at this time? (HC-04, HC-08, HC-01, HC-03, HC-07, HC-10)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="1072.8" width="468.0" height="91.8" as="geometry"/></mxCell>
<mxCell id="n_rooms" value="(5) Search the rooms in the order of rooms.csv. Take the room that passes all ROOM rules (HC-11, HC-06, HC-05, HC-09, HC-02) and has the fewest warnings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="1185.0" width="468.0" height="69.0" as="geometry"/></mxCell>
<mxCell id="n_d_room" value="Was a suitable room found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="1274.4" width="468.0" height="62.4" as="geometry"/></mxCell>
<mxCell id="n_count" value="Count the soft-constraint warnings of this place (SC-01, SC-02, SC-03, SC-05). Keep the place if it has fewer warnings than the best place so far" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="1357.2" width="468.0" height="51.6" as="geometry"/></mxCell>
<mxCell id="n_d_again" value="(8) Is there another time to try?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="1429.2" width="468.0" height="62.4" as="geometry"/></mxCell>
<mxCell id="n_d_found" value="Was a valid place (time and room) found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="1512.0" width="468.0" height="62.4" as="geometry"/></mxCell>
<mxCell id="n_d_valid" value="Did at least one time pass the TIME rules?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="1594.8" width="468.0" height="74.4" as="geometry"/></mxCell>
<mxCell id="n_constraint" value="(10) Report: the session is unscheduled with the label CONSTRAINT, the last rule code and the reason" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="1689.6" width="468.0" height="51.6" as="geometry"/></mxCell>
<mxCell id="n_show" value="Show the results: [OK] or [FAIL] for every session, the warnings and the summary" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#DDEBF7;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="126.0" y="1776.0" width="468.0" height="51.6" as="geometry"/></mxCell>
<mxCell id="n_end" value="(11) END: the timetable generation is complete (a placed session is never moved)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#E7E6E6;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="192.0" y="1848.0" width="336.0" height="52.8" as="geometry"/></mxCell>
<mxCell id="n_f_constraint" value="(7) Conflict: the session is unscheduled with the label CONSTRAINT and the code of the broken rule" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="714.0" y="479.7" width="336.0" height="51.6" as="geometry"/></mxCell>
<mxCell id="n_f_noroom" value="The session is unscheduled with the label NO ROOM and the reason" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBE5D6;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="714.0" y="591.9" width="336.0" height="51.6" as="geometry"/></mxCell>
<mxCell id="n_p_assign" value="Assign the session to the preferred time and room" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="714.0" y="926.1" width="336.0" height="34.2" as="geometry"/></mxCell>
